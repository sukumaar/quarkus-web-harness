{
  "name": "fastify-prisma-pg-boss-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "generate": "DB_PROVIDER=postgres prisma generate && DB_PROVIDER=sqlite prisma generate",
    "db:push": "prisma db push",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/autoload": "~6.5.1",
    "@prisma/adapter-better-sqlite3": "~7.10.0",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "dotenv": "~17.4.2",
    "fastify": "~5.12.5",
    "pg-boss": "~12.36.0"
  },
  "devDependencies": {
    "@types/node": "~24.13.4",
    "prisma": "~7.10.0",
    "tsx": "~4.23.14",
    "typescript": "~7.0.2"
  }
}
